local player = game.Players.LocalPlayer
local character = player.Character

player.CharacterAdded:Connect(function(newchar)
    character = newchar
end)

-- Change team
function ChangeTeam(team, subteam)
    game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("ChangeTeam"):FireServer(team, subteam)
end

-- Auto heal
local AutoHealLoopConn
function AutoHealLoop(TargetCharacter)
    local LastHealth = TargetCharacter.Humanoid.Health
    if not (player.Backpack:FindFirstChild("BLS")) or (not character) or (not TargetCharacter) then return false end
    AutoHealLoopConn = TargetCharacter.Humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if TargetCharacter.Humanoid.Health < LastHealth then
            for i = 0, LastHealth - TargetCharacter.Humanoid.Health do
                player.Backpack.BLS.LocalScript.RemoteEvent:FireServer(TargetCharacter.Humanoid)
            end
        end
    end)
    return
end

-- Grab cuffs
function GrabCuffs()
    if not workspace.Tutorial:FindFirstChild(tostring(player.UserId)) then return false end
    local tries = 0;
    while character do
        tries = tries + 1
        if tries > 100 or player.Backpack:FindFirstChild("Handcuffs") then
            return
        end
        character.PrimaryPart.CFrame = workspace.Tutorial[tostring(player.UserId)].Guard.Handcuffs.Handle.CFrame
        task.wait()
        fireproximityprompt(workspace.Tutorial[tostring(player.UserId)].Guard.Handcuffs.Handle.Prompt)
    end
    return
end

--- Anti tase
local AntiTaseConn
function EnableAntiTase()
    AntiTaseConn = character.Humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
        if character.Humanoid.PlatformStand == true then
            character.Humanoid.PlatformStand = false
            character.Humanoid.AutoRotate = true
        end
    end)
end

-- Make solitary doors non collide
function MakeSolitaryDoorsNonCollide(bool)
    for _, SL in pairs(workspace.Solitary.Cells:GetChildren()) do
     for _, v in pairs(SL.Door.Door.DoorMain:GetDescendants()) do
         if v:IsA("Part") then
                v.CanCollide = bool
            end
         end
    end
end

-- Grab tool
local DroppedTools = workspace.DroppedTools
function GrabDroppedTool(name)
    local TargetTool = DroppedTools[name]
    local tries = 0
    repeat
        task.wait()
        tries = tries + 1
        character.PrimaryPart.CFrame = TargetTool.click_box.CFrame
        fireclickdetector(TargetTool.click_box.ClickDetector)
    until tries > 100 or not character or TargetTool.Parent ~= DroppedTools
end

