local module = {}

local competitors = {}
local eliminated = {}
local inProgress = false

local waitTime = 5

function checkJump(p)
	if not p then return end
	local s = false
	local c = p.Character.Humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
		s = true
	end)
	task.wait(waitTime)
	c:Disconnect()
	return s
end

function checkChat(p, text)
	if not p then return end
	local s = false
	local c = p.Chatted:Connect(function(msg)
		if string.lower(msg):find(text) then
			s = true
		end
	end)
	task.wait(waitTime)
	c:Disconnect()
	return s
end

function checkSpin(p)
	if not p then return end
	local s = false
	local count = 0
	local lastRotation = p.Character.HumanoidRootPart.CFrame.LookVector
	local c = game:GetService("RunService").Heartbeat:Connect(function()
		local rotation = p.Character.HumanoidRootPart.CFrame.LookVector
		if (lastRotation - rotation).Magnitude > 0.5 then
			count = count + 1
		end
		lastRotation = rotation
	end)
	task.wait(waitTime)
	if count > 20 then
		s = true
	end
	c:Disconnect()
	return s
end

local TextChatService = game:GetService("TextChatService")
local Players = game:GetService("Players")

function message(msg)
	TextChatService.TextChannels.RBXGeneral:SendAsync(msg)
end

function promptMessage(text)
	local messageChecked = false
	local messageFlagged = false
	local c; c = TextChatService.MessageReceived:Connect(function(m)
		if m.TextSource.UserId == Players.LocalPlayer.UserId then
			messageChecked = true
			if m.Text:find("#") then
				messageFlagged = true
			end
			c:Disconnect()
		end
	end)
	message(text)
	repeat
		task.wait()
	until messageChecked == true
	if messageFlagged then
		message("Message filtered, moving onto next.")
		task.wait(2)
		do return end
	end
end

local fakes = {"slimon says", "simion says", "suimon says", "symoon says"}

function eliminate(p)
	table.remove(competitors, table.find(competitors, p))
	table.insert(eliminated, p.DisplayName)
end

-- True prompts
local tq = {
	[1] = {"Simon says jump.", function(p)
		if not checkJump(p) then
			eliminate(p)
		end
	end},
	
	[2] = {"Simon says chat hi", function(p)
		if not checkChat(p, "hi") then
			eliminate(p)
		end
	end},
	
	[3] = {"Simon says spin.", function(p)
		if not checkSpin(p) then
			eliminate(p)
		end
	end},
}

-- False prompts
local fq = {
	[1] = {"Jump 5 times.", function(p)
		if checkJump(p) then
			eliminate(p)
		end
	end},

	[2] = {fakes[math.random(1, #fakes)].." jump.", function(p)
		if checkJump(p) then
			eliminate(p)
		end
	end},
	[3] = {"Say hi in the chat.", function(p)
		if checkChat(p, "hi") then
			eliminate(p)
		end
	end},
	[4] = {fakes[math.random(1, #fakes)].." spin.", function(p)
		if checkSpin(p) then
			eliminate(p)
		end
	end},
	[5] = {"Spin until I say to stop.", function(p)
		if checkSpin(p) then
			eliminate(p)
		end
	end},
}

module.Start = function(players)
	message("Starting game.")
	for _, v in pairs(players) do
		table.insert(competitors, v)
	end
	inProgress = true
	repeat
		if not inProgress then return end
		local prompt
		if math.random(1, 3) == 1 then
			prompt = fq[math.random(1, #fq)]
		else
			prompt = tq[math.random(1, #tq)]
		end
		promptMessage(prompt[1])
		task.wait(0.5)
		for i, v in pairs(competitors) do
			prompt[2](v)
		end
		task.wait(waitTime + 0.1)
		
		if #eliminated > 0 then
			message("Eliminated players: "..table.concat(eliminated, ", "))
			table.clear(eliminated)
		end
	until #competitors <= 1
	if #competitors == 1 then
		message(competitors[1].DisplayName.." has won the game.")
	elseif #competitors == 0 then
		message("No one has won the game.")
	end
	table.clear(competitors)
end

module.End = function()
	inProgress = false
	table.clear(competitors)
	message("Game has ended.")
end

module.AddPlayer = function(player)
	if game:GetService("Players")[player] then
		table.insert(competitors, player)
	else
		message("Invalid player.")
	end
end

return module
